<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FirstFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollview_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <LinearLayout
                    android:id="@+id/layout_date_picker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/textview_date_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_date_selector"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textview_selected_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="October 24, 2023"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <Button
                        android:id="@+id/button_pick_date"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/button_change_date" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textview_description_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/faster_description"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/layout_date_picker" />

                <RadioGroup
                    android:id="@+id/radiogroup_scale"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/textview_description_label">

                    <RadioButton
                        android:id="@+id/radio_restoration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scale_restoration" />

                    <RadioButton
                        android:id="@+id/radio_forgetting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scale_forgetting" />

                    <RadioButton
                        android:id="@+id/radio_anxiety"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scale_anxiety" />

                    <RadioButton
                        android:id="@+id/radio_speeding"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scale_speeding" />

                    <RadioButton
                        android:id="@+id/radio_ticked"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scale_ticked_off" />

                    <RadioButton
                        android:id="@+id/radio_exhausted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scale_exhausted" />

                    <RadioButton
                        android:id="@+id/radio_relapse"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scale_relapse" />
                </RadioGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textinputlayout_description"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:hint="@string/hint_description"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/radiogroup_scale">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edittext_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:minLines="12" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_save"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/save_checkin"
                    app:icon="@drawable/ic_save"
                    app:iconGravity="textStart"
                    app:iconSize="24dp"
                    app:layout_constraintTop_toBottomOf="@id/textinputlayout_description" />

                <LinearLayout
                    android:id="@+id/layout_navigation_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/button_save">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_to_calendar"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/go_to_calendar"
                        app:icon="@drawable/ic_calendar" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_to_history"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/go_to_history"
                        app:icon="@drawable/ic_history" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>