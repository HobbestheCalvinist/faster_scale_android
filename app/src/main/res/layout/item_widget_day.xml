<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="2dp">

    <TextView
        android:id="@+id/text_day_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="M"
        android:textSize="11sp"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <FrameLayout
        android:id="@+id/day_background_container"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/calendar_day_background">

        <TextView
            android:id="@+id/text_day_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="1"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurface" />

        <ImageView
            android:id="@+id/image_call_indicator"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="top|end"
            android:layout_margin="1dp"
            android:src="@drawable/ic_call"
            android:visibility="gone"
            android:contentDescription="Call scheduled" />

        <ImageView
            android:id="@+id/image_checkin_indicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="2dp"
            android:src="@drawable/ic_dot_marker"
            android:visibility="gone"
            android:contentDescription="Check-in completed" />
    </FrameLayout>
</LinearLayout>