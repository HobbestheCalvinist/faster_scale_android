<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_container_background"
    android:orientation="horizontal"
    android:padding="2dp"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/button_checkin"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/icon_checkin"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_edit"
            android:contentDescription="Quick Check-in" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check-in"
            android:textSize="10sp"
            android:textColor="@color/widget_text_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/button_call"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/icon_call"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_call"
            android:contentDescription="Quick Call" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Call"
            android:textSize="10sp"
            android:textColor="@color/widget_text_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/button_commitment"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/icon_commitment"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_checklist"
            android:contentDescription="Quick Commitment" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Commit"
            android:textSize="10sp"
            android:textColor="@color/widget_text_primary" />
    </LinearLayout>
</LinearLayout>