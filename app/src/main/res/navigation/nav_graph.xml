<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/FirstFragment">

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.example.myapplication.CheckinFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_first">

        <argument
            android:name="selectedDate"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />

        <action
            android:id="@+id/action_FirstFragment_to_HistoryFragment"
            app:destination="@id/HistoryFragment" />
        <action
            android:id="@+id/action_global_SettingsFragment"
            app:destination="@id/SettingsFragment" />
        <action
            android:id="@+id/action_FirstFragment_to_CommitmentFragment"
            app:destination="@id/CommitmentFragment" />
    </fragment>

    <fragment
        android:id="@+id/HistoryFragment"
        android:name="com.example.myapplication.HistoryFragment"
        android:label="@string/history_fragment_label"
        tools:layout="@layout/fragment_history">
        <action
            android:id="@+id/action_HistoryFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />
    </fragment>

    <fragment
        android:id="@+id/SettingsFragment"
        android:name="com.example.myapplication.SettingsFragment"
        android:label="@string/settings_fragment_label"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/CallScheduleFragment"
        android:name="com.example.myapplication.CallScheduleFragment"
        android:label="@string/call_schedule_fragment_label"
        tools:layout="@layout/fragment_call_schedule" />

    <fragment
        android:id="@+id/CommitmentFragment"
        android:name="com.example.myapplication.CommitmentFragment"
        android:label="Commitment to Change"
        tools:layout="@layout/fragment_commitment" />
</navigation>